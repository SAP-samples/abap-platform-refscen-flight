extension using interface /dmo/i_agencytp
implementation in class /dmo/zz_bp_x_cntry_r_agencytp unique;

extend behavior for /DMO/Agency
{

  validation /DMO/zzValidateDiallingCode on save { field PhoneNumber; }

  determination /DMO/zzDetermineCountryCode on modify { field PhoneNumber; }

  determination /DMO/zzDetermineDiallingCode on modify { field CountryCode; }

  extend draft determine action Prepare
  {
    validation /DMO/zzValidateDiallingCode;
  }

  action ( authorization : update ) /DMO/zzChangeAddress parameter /DMO/ZZ_A_Address result [1] $self;

}